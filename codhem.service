[Unit]
Description=CODHEM Streamlit server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mcdc/codhem
ExecStartPre=/usr/bin/env bash /opt/mcdc/codhem/update.sh
ExecStart=/usr/bin/env bash -lc 'cd /opt/mcdc/codhem && uv run streamlit run main.py --server.headless true'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
